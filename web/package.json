{
  "name": "lifolo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lifolo ওয়েব — মোবাইল, ট্যাবলেট আর ডেস্কটপের জন্য (অ্যাপের একই সার্ভার আর অ্যাকাউন্ট)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:test": "vite build --mode test --outDir test/.build/w --emptyOutDir",
    "typecheck": "tsc --noEmit -p .",
    "shots": "node test/shots.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.1.0",
    "@fontsource/roboto": "^5.1.0",
    "@tanstack/react-query": "^5.62.0",
    "firebase": "^11.1.0",
    "geofire-common": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
