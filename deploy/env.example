# Lifolo সার্ভারের গোপন সেটিং — VPS-এ /etc/lifolo/env (systemd EnvironmentFile)।
# নিয়ম: প্রতি লাইনে KEY=value, = এর দুপাশে ফাঁকা নয়। বিশেষ চিহ্ন (& ? = ফাঁকা) থাকলে মান '...' একক উদ্ধৃতিতে রাখুন।
# setup-vps.sh এই ফাইলটা একবার কপি করে, আর খালি থাকা CRON_SECRET / WEB_SESSION_SECRET / DATABASE_URL নিজে বসায়।
# বদলানোর পর:  sudo systemctl restart lifolo

# ---------- Vercel থেকে কপি করতে হবে ----------
# Firebase-এর service account JSON — এক লাইনে base64 করে (systemd এক লাইনের মান চায়):
#   base64 -w0 service-account.json
# (সরাসরি JSON-ও চলে যদি পুরোটা এক লাইনে থাকে, তবে base64 নিরাপদ)
FIREBASE_SERVICE_ACCOUNT=

# অ্যাডমিনদের ইমেইল, কমা দিয়ে আলাদা: a@gmail.com,b@gmail.com
ADMIN_EMAILS=

# ইমেইলে লগইন কোড পাঠানোর Gmail আর তার App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SMS গেটওয়ের GET লিংক; {to} আর {msg} বসানো থাকবে। খালি রাখলে ফোন যাচাই বন্ধ থাকে। উদাহরণ:
# SMS_URL_TEMPLATE='https://gateway.example/api/send?api_key=KEY&number={to}&message={msg}'
SMS_URL_TEMPLATE=

# ---------- setup-vps.sh নিজে বসায় (Vercel-এ থাকলে সেটা দিয়ে বদলানো ভালো) ----------
# দৈনিক ক্রনের চাবি; ফোন যাচাইয়ের কোডের হ্যাশেও লাগে
CRON_SECRET=
# ওয়েব/অ্যাডমিন প্যানেলের লগইন কুকির চাবি (বদলালে সবাইকে একবার আবার লগইন করতে হয়)
WEB_SESSION_SECRET=

# PostgreSQL (একই মেশিনে)। ডাটা সরানো (পরের ধাপ) শেষ না হওয়া পর্যন্ত লাইনটা # দিয়ে বন্ধ থাকে —
# তখন সার্ভার আগের মতো Firestore ব্যবহার করে। চালু করতে সামনের # মুছে restart দিন।
#DATABASE_URL=

# ---------- সার্ভার নিজে (সাধারণত বদলাতে হয় না) ----------
PORT=3000
# শুধু nginx-এর কাছ থেকে অনুরোধ নেয়; বাইরে থেকে সরাসরি নয়
HOST=127.0.0.1
NODE_ENV=production
# vercel.json-এ maxDuration না থাকা API-র সময়সীমা (সেকেন্ড)
DEFAULT_MAX_DURATION=300
# বন্ধ করার সময় চলতি অনুরোধ শেষ হওয়ার জন্য সর্বোচ্চ অপেক্ষা (সেকেন্ড; systemd-এর TimeoutStopSec-এর কম)
SHUTDOWN_TIMEOUT=25
# লোকালহোস্ট ছাড়া অন্য বিশ্বস্ত প্রক্সির IP (কমা দিয়ে); nginx একই মেশিনে থাকলে খালি
TRUSTED_PROXIES=
# ক্রন রানার (standalone/cron.js): না দিলে http://127.0.0.1:$PORT, সময়সীমা ৯০০ সেকেন্ড
CRON_BASE_URL=
CRON_TIMEOUT=900
