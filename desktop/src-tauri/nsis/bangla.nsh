; Lifolo ইনস্টলারের বাংলা লেখা (UTF-8)।
; NSIS-এ বাংলা ভাষার ফাইল নেই, তাই "English"-এর জায়গায় এই ফাইল (tauri.conf.json → nsis.customLanguageFiles):
;  ১) Tauri-র নিজের লেখা (languages/English.nsh-এর সব নাম), ২) MUI-এর পাতার লেখা আর বোতাম — MUI_LANGUAGE-এর পরে
;     include হয় বলে এখানকারটাই থাকে (makensis "set multiple times" সতর্কতা দেয়, ভুল নয়)।

; ---- Tauri
LangString addOrReinstall ${LANG_ENGLISH} "কিছু যোগ করুন / আবার বসান"
LangString alreadyInstalled ${LANG_ENGLISH} "আগেই বসানো আছে"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} আগেই বসানো আছে। কী করবেন বাছাই করে 'পরের ধাপ' চাপুন।"
LangString appRunning ${LANG_ENGLISH} "${PRODUCTNAME} চালু আছে! আগে বন্ধ করে আবার চেষ্টা করুন।"
LangString appRunningOkKill ${LANG_ENGLISH} "${PRODUCTNAME} চালু আছে!$\nবন্ধ করতে OK চাপুন"
LangString chooseMaintenanceOption ${LANG_ENGLISH} "কী করবেন বাছাই করুন।"
LangString choowHowToInstall ${LANG_ENGLISH} "${PRODUCTNAME} কীভাবে বসাবেন বাছাই করুন।"
LangString createDesktop ${LANG_ENGLISH} "ডেস্কটপে শর্টকাট রাখুন"
LangString dontUninstall ${LANG_ENGLISH} "মুছবেন না"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "মুছবেন না (পুরোনো ভার্সন বসাতে আগে নতুনটা মুছতে হয়)"
LangString failedToKillApp ${LANG_ENGLISH} "${PRODUCTNAME} বন্ধ করা গেল না। নিজে বন্ধ করে আবার চেষ্টা করুন"
LangString installingWebview2 ${LANG_ENGLISH} "WebView2 বসানো হচ্ছে…"
LangString newerVersionInstalled ${LANG_ENGLISH} "${PRODUCTNAME}-এর নতুন ভার্সন আগেই বসানো আছে! পুরোনোটা বসানো ঠিক নয়। তবুও চাইলে আগে নতুনটা মুছে নিন। কী করবেন বাছাই করে 'পরের ধাপ' চাপুন।"
LangString older ${LANG_ENGLISH} "পুরোনো"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "${PRODUCTNAME}-এর একটা $R4 ভার্সন বসানো আছে। নতুনটা বসানোর আগে সেটা মুছে নেওয়া ভালো। কী করবেন বাছাই করে 'পরের ধাপ' চাপুন।"
LangString silentDowngrades ${LANG_ENGLISH} "পুরোনো ভার্সন চুপচাপ বসানো যায় না — ইনস্টলারটা সাধারণভাবে খুলুন।$\n"
LangString unableToUninstall ${LANG_ENGLISH} "মোছা গেল না!"
LangString uninstallApp ${LANG_ENGLISH} "${PRODUCTNAME} মুছুন"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "বসানোর আগে আগেরটা মুছুন"
LangString unknown ${LANG_ENGLISH} "অজানা"
LangString webview2AbortError ${LANG_ENGLISH} "WebView2 বসানো গেল না! এটা ছাড়া Lifolo চলে না। ইন্টারনেট দেখে ইনস্টলারটা আবার চালান।"
LangString webview2DownloadError ${LANG_ENGLISH} "WebView2 নামানো গেল না — $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 নামানো হয়েছে"
LangString webview2Downloading ${LANG_ENGLISH} "WebView2 নামানো হচ্ছে…"
LangString webview2InstallError ${LANG_ENGLISH} "WebView2 বসানো গেল না (কোড $1)"
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 বসানো হয়েছে"
LangString deleteAppData ${LANG_ENGLISH} "অ্যাপের তথ্যও মুছুন (সিঙ্ক না হওয়া রসিদও মুছে যাবে)"

; ---- NSIS-এর বোতাম আর শিরোনাম
LangString ^SetupCaption ${LANG_ENGLISH} "$(^Name) — বসানো"
LangString ^UninstallCaption ${LANG_ENGLISH} "$(^Name) — মোছা"
LangString ^NextBtn ${LANG_ENGLISH} "পরের ধাপ >"
LangString ^BackBtn ${LANG_ENGLISH} "< আগের ধাপ"
LangString ^CancelBtn ${LANG_ENGLISH} "বাতিল"
LangString ^InstallBtn ${LANG_ENGLISH} "বসান"
LangString ^UninstallBtn ${LANG_ENGLISH} "মুছুন"
LangString ^CloseBtn ${LANG_ENGLISH} "বন্ধ করুন"
LangString ^BrowseBtn ${LANG_ENGLISH} "খুঁজুন…"
LangString ^ShowDetailsBtn ${LANG_ENGLISH} "বিস্তারিত দেখুন"
LangString ^Completed ${LANG_ENGLISH} "শেষ"
LangString ^DirSubText ${LANG_ENGLISH} "যে ফোল্ডারে বসবে"
LangString ^SpaceRequired ${LANG_ENGLISH} "জায়গা লাগবে: "
LangString ^SpaceAvailable ${LANG_ENGLISH} "খালি আছে: "

; ---- MUI-এর পাতা
LangString MUI_TEXT_WELCOME_INFO_TITLE ${LANG_ENGLISH} "Lifolo বসানো শুরু"
LangString MUI_TEXT_WELCOME_INFO_TEXT ${LANG_ENGLISH} "এই কম্পিউটারে Lifolo বসানো হবে — ফার্মেসি, ল্যাব আর চেম্বারের বিক্রি ও রসিদ, ইন্টারনেট না থাকলেও।$\r$\n$\r$\nশুধু lifolo.com/download থেকে নামানো ইনস্টলার চালান।$\r$\n$\r$\nশুরু করতে 'পরের ধাপ' চাপুন।"
LangString MUI_TEXT_DIRECTORY_TITLE ${LANG_ENGLISH} "কোথায় বসাবেন"
LangString MUI_TEXT_DIRECTORY_SUBTITLE ${LANG_ENGLISH} "Lifolo যে ফোল্ডারে বসবে সেটা বাছাই করুন।"
LangString MUI_TEXT_STARTMENU_TITLE ${LANG_ENGLISH} "স্টার্ট মেনুর ফোল্ডার"
LangString MUI_TEXT_STARTMENU_SUBTITLE ${LANG_ENGLISH} "Lifolo-র শর্টকাট কোন ফোল্ডারে থাকবে।"
LangString MUI_INNERTEXT_STARTMENU_TOP ${LANG_ENGLISH} "শর্টকাটের জন্য স্টার্ট মেনুর ফোল্ডার বাছাই করুন, বা নতুন নাম লিখুন।"
LangString MUI_INNERTEXT_STARTMENU_CHECKBOX ${LANG_ENGLISH} "শর্টকাট বানাবেন না"
LangString MUI_TEXT_INSTALLING_TITLE ${LANG_ENGLISH} "বসানো হচ্ছে"
LangString MUI_TEXT_INSTALLING_SUBTITLE ${LANG_ENGLISH} "একটু অপেক্ষা করুন, Lifolo বসানো হচ্ছে।"
LangString MUI_TEXT_FINISH_TITLE ${LANG_ENGLISH} "বসানো শেষ"
LangString MUI_TEXT_FINISH_SUBTITLE ${LANG_ENGLISH} "Lifolo ঠিকমতো বসানো হয়েছে।"
LangString MUI_TEXT_ABORT_TITLE ${LANG_ENGLISH} "বসানো থেমে গেছে"
LangString MUI_TEXT_ABORT_SUBTITLE ${LANG_ENGLISH} "Lifolo বসানো শেষ হয়নি।"
LangString MUI_TEXT_FINISH_INFO_TITLE ${LANG_ENGLISH} "Lifolo প্রস্তুত"
LangString MUI_TEXT_FINISH_INFO_TEXT ${LANG_ENGLISH} "এই কম্পিউটারে Lifolo বসানো হয়েছে।$\r$\n$\r$\nবন্ধ করতে 'শেষ' চাপুন।"
LangString MUI_TEXT_FINISH_RUN ${LANG_ENGLISH} "এখনই Lifolo চালু করুন"
LangString MUI_BUTTONTEXT_FINISH ${LANG_ENGLISH} "শেষ"
LangString MUI_TEXT_ABORTWARNING ${LANG_ENGLISH} "Lifolo বসানো বন্ধ করবেন?"
LangString MUI_UNTEXT_CONFIRM_TITLE ${LANG_ENGLISH} "Lifolo মুছুন"
LangString MUI_UNTEXT_CONFIRM_SUBTITLE ${LANG_ENGLISH} "এই কম্পিউটার থেকে Lifolo মুছে ফেলা হবে।"
LangString MUI_UNTEXT_UNINSTALLING_TITLE ${LANG_ENGLISH} "মোছা হচ্ছে"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE ${LANG_ENGLISH} "একটু অপেক্ষা করুন, Lifolo মোছা হচ্ছে।"
LangString MUI_UNTEXT_FINISH_TITLE ${LANG_ENGLISH} "মোছা শেষ"
LangString MUI_UNTEXT_FINISH_SUBTITLE ${LANG_ENGLISH} "Lifolo মুছে ফেলা হয়েছে।"
LangString MUI_UNTEXT_ABORT_TITLE ${LANG_ENGLISH} "মোছা থেমে গেছে"
LangString MUI_UNTEXT_ABORT_SUBTITLE ${LANG_ENGLISH} "Lifolo মোছা শেষ হয়নি।"
LangString MUI_UNTEXT_ABORTWARNING ${LANG_ENGLISH} "Lifolo মোছা বন্ধ করবেন?"
