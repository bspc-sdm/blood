rules_version = '2';

// এই ফাইলটা রেকর্ড হিসেবে রাখা। আসল নিয়ম Firebase কনসোলে প্রকাশ করা আছে;
// এখানে বদলালে কনসোলেও একই নিয়ম প্রকাশ করতে হবে।
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function requestDoc(rid) { return get(/databases/$(database)/documents/requests/$(rid)); }
    // প্রোফাইল (ফোন নম্বর, লোকেশন): শুধু নিজে দেখতে ও বদলাতে পারবে
    // শেষ রক্তদানের তারিখ একবার দিলে শুধু সামনে এগোনো যায়, পেছানো বা মোছা যায় না
    // (যাতে কেউ তারিখ পিছিয়ে সময়ের আগে "যোগ্য" সাজতে না পারে)
    function donationDateOnlyForward() {
      let before = resource.data.get('lastDonationMillis', null);
      let after = request.resource.data.get('lastDonationMillis', null);
      return before == null || (after != null && after >= before);
    }
    match /users/{uid} {
      // নিজের প্রোফাইল নথি মুছে আবার বানিয়ে "শেষ রক্তদান" মুছে ফেলা যায় না; অ্যাকাউন্ট মোছা সার্ভার দিয়ে
      allow read: if signedIn() && me() == uid;
      allow delete: if false;
      allow create: if signedIn() && me() == uid;
      allow update: if signedIn() && me() == uid && donationDateOnlyForward();
    }

    // রক্তের রিকোয়েস্ট: লগইন করা সবাই দেখতে পারবে (ফোন নম্বর এখানে থাকে না)
    match /requests/{rid} {
      allow read: if signedIn();
      // তৈরি আর বন্ধ শুধু সার্ভার দিয়ে (দৈনিক সীমা, ব্যাগের হিসাব, ডোনারদের জানানো, geoOpen — সব সার্ভারে)।
      // আগের অ্যাপের সরাসরি তৈরি/বন্ধ করার ছাড় বন্ধ (১৬ অক্টোবর ২০২৬)।
      allow create, update: if false;
      allow delete: if false;

      // রক্তপ্রার্থীর ফোন: শুধু রক্তপ্রার্থী নিজে আর যে ডোনার এখন রাজি আছে বা রক্ত দিয়েছে
      match /private/{doc} {
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/requests/$(rid)).data.requesterUid == me();
        allow read: if signedIn() && (
          requestDoc(rid).data.requesterUid == me()
          || (requestDoc(rid).data.status == 'open'
              && get(/databases/$(database)/documents/requests/$(rid)/responses/$(me())).data.status
                   in ['accepted', 'donated']));
        allow update, delete: if false;
      }

      // ডোনারের সাড়া (ডোনারের নাম ও ফোন সহ): ডোনার নিজে আর রক্তপ্রার্থী দেখতে পারবে
      match /responses/{donorUid} {
        // রক্তপ্রার্থী শুধু রাজি থাকা বা রক্ত দেওয়া ডোনারদের দেখতে পারবে (বাতিল/বাদ পড়াদের নয়)
        allow read: if signedIn() && (
          me() == donorUid
          || (requestDoc(rid).data.requesterUid == me()
              && resource.data.status in ['accepted', 'donated']));
        // "রক্ত দেব" শুধু সার্ভারের মাধ্যমে (দৈনিক সীমা আর যোগ্যতা সার্ভার যাচাই করে)
        allow create: if false;
        // বাতিল, "রক্ত দিয়েছি", ডোনার বাদ দেওয়া — সব সার্ভার দিয়ে (হিসাব আর নোটিফিকেশন সেখানে)
        allow update: if false;
        allow delete: if false;
      }
    }

    // শেষ রক্তদানের তারিখ সংশোধনের অনুরোধ: নিজের নামে পাঠানো আর নিজেরটা দেখা যায়;
    // অনুমোদন শুধু সার্ভারের মাধ্যমে অ্যাডমিন দেন
    match /correctionRequests/{id} {
      // নতুন অনুরোধ সার্ভার দিয়ে (অ্যাপের "শেষ রক্তদানের তারিখ বদল"); সরাসরি লেখা বন্ধ
      allow create: if false;
      allow read: if signedIn() && resource.data.uid == me();
      allow update, delete: if false;
    }

    // সার্ভারের হিসাব (দৈনিক সীমা ইত্যাদি): অ্যাপ থেকে পড়া বা লেখা যাবে না
    match /serverState/{uid} {
      allow read, write: if false;
    }

    // রিপোর্ট: যে কেউ পাঠাতে পারবে, কেউ পড়তে পারবে না (শুধু কনসোল থেকে দেখা যাবে)
    match /reports/{id} {
      // একজন একটা রিকোয়েস্ট একবারই (নথির নাম = রিকোয়েস্ট_নিজের uid), শুধু এই তিনটা ঘর
      allow create: if signedIn()
        && request.resource.data.reporterUid == me()
        && request.resource.data.keys().hasOnly(['requestId', 'reporterUid', 'createdAtMillis'])
        && request.resource.data.requestId is string
        && id == request.resource.data.requestId + '_' + me()
        && request.resource.data.createdAtMillis is int;
      allow read, update, delete: if false;
    }
  }
}
