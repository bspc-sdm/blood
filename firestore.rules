rules_version = '2';

// এই ফাইলটা রেকর্ড হিসেবে রাখা। আসল নিয়ম Firebase কনসোলে প্রকাশ করা আছে;
// এখানে বদলালে কনসোলেও একই নিয়ম প্রকাশ করতে হবে।
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function requestDoc(rid) { return get(/databases/$(database)/documents/requests/$(rid)); }
    // রিকোয়েস্টের তথ্য ঠিক আছে কি না (সার্ভারের validateRequest-এর মতো)
    function validRequest(d) {
      return d.patientGroup in ['A+', 'A-', 'B+', 'B-', 'O+', 'O-', 'AB+', 'AB-']
        && d.bags is int && d.bags >= 1 && d.bags <= 10
        && d.hospital is string && d.hospital.size() > 0 && d.hospital.size() <= 120
        && d.placeName is string && d.placeName.size() <= 40
        && d.requesterName is string && d.requesterName.size() <= 80
        && d.note is string && d.note.size() <= 300
        && d.lat is number && d.lat >= 20.5 && d.lat <= 26.7
        && d.lng is number && d.lng >= 88 && d.lng <= 92.7
        && d.neededByMillis is int
        && d.urgent is bool;
    }
    function onlyStatusChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // প্রোফাইল (ফোন নম্বর, লোকেশন): শুধু নিজে দেখতে ও বদলাতে পারবে
    // শেষ রক্তদানের তারিখ একবার দিলে শুধু সামনে এগোনো যায়, পেছানো বা মোছা যায় না
    // (যাতে কেউ তারিখ পিছিয়ে সময়ের আগে "যোগ্য" সাজতে না পারে)
    function donationDateOnlyForward() {
      let before = resource.data.get('lastDonationMillis', null);
      let after = request.resource.data.get('lastDonationMillis', null);
      return before == null || (after != null && after >= before);
    }
    match /users/{uid} {
      // নিজের প্রোফাইল নথি মুছে আবার বানিয়ে "শেষ রক্তদান" মুছে ফেলা যায় না; অ্যাকাউন্ট মোছা সার্ভার দিয়ে
      allow read: if signedIn() && me() == uid;
      allow delete: if false;
      allow create: if signedIn() && me() == uid;
      allow update: if signedIn() && me() == uid && donationDateOnlyForward();
    }

    // রক্তের রিকোয়েস্ট: লগইন করা সবাই দেখতে পারবে (ফোন নম্বর এখানে থাকে না)
    match /requests/{rid} {
      allow read: if signedIn();
      // নতুন অ্যাপ সার্ভার দিয়ে তৈরি করে (সীমা সার্ভারে)। পুরোনো অ্যাপের জন্য সরাসরি তৈরি এখনো খোলা, কিন্তু
      // শুধু এই ঘরগুলো, তারিখ ৩২ দিনের মধ্যে — ভুয়া "ডোনার পাওয়া গেছে"/রাজির সংখ্যা বসানো যায় না।
      // সবাই আপডেট করলে এটা `if false` হবে।
      allow create: if signedIn()
        && request.resource.data.requesterUid == me()
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['requesterUid', 'requesterName', 'patientGroup', 'bags', 'hospital',
             'placeName', 'lat', 'lng', 'geohash', 'neededByMillis', 'neededAtMillis', 'urgent', 'travelFare', 'note',
             'status', 'createdAtMillis', 'createdAt'])
        && request.resource.data.neededByMillis <= request.time.toMillis() + 32 * 86400000
        && request.resource.data.neededByMillis + 86400000 > request.time.toMillis()
        && validRequest(request.resource.data);
      // শুধু রক্তপ্রার্থী নিজে বন্ধ করতে পারেন। সময় পার হলে রাতের কাজ (সার্ভার) বন্ধ করে রাজি ডোনারদের জানায়।
      allow update: if signedIn()
        && onlyStatusChanges()
        && request.resource.data.status == 'closed'
        && resource.data.requesterUid == me();
      allow delete: if false;

      // রক্তপ্রার্থীর ফোন: শুধু রক্তপ্রার্থী নিজে আর যে ডোনার এখন রাজি আছে বা রক্ত দিয়েছে
      match /private/{doc} {
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/requests/$(rid)).data.requesterUid == me();
        allow read: if signedIn() && (
          requestDoc(rid).data.requesterUid == me()
          || (requestDoc(rid).data.status == 'open'
              && get(/databases/$(database)/documents/requests/$(rid)/responses/$(me())).data.status
                   in ['accepted', 'donated']));
        allow update, delete: if false;
      }

      // ডোনারের সাড়া (ডোনারের নাম ও ফোন সহ): ডোনার নিজে আর রক্তপ্রার্থী দেখতে পারবে
      match /responses/{donorUid} {
        // রক্তপ্রার্থী শুধু রাজি থাকা বা রক্ত দেওয়া ডোনারদের দেখতে পারবে (বাতিল/বাদ পড়াদের নয়)
        allow read: if signedIn() && (
          me() == donorUid
          || (requestDoc(rid).data.requesterUid == me()
              && resource.data.status in ['accepted', 'donated']));
        // "রক্ত দেব" শুধু সার্ভারের মাধ্যমে (দৈনিক সীমা আর যোগ্যতা সার্ভার যাচাই করে)
        allow create: if false;
        allow update: if signedIn() && (
          // ডোনার: রাজি থাকা অবস্থা থেকে শুধু বাতিল বা "রক্ত দিয়েছি"
          (me() == donorUid
            && resource.data.status == 'accepted'
            && onlyStatusChanges()
            && request.resource.data.status in ['cancelled', 'donated'])
          // রক্তপ্রার্থী: শুধু কোনো ডোনারকে বাদ দিতে পারবে
          || (requestDoc(rid).data.requesterUid == me()
              && resource.data.status == 'accepted'
              && onlyStatusChanges()
              && request.resource.data.status == 'declined'));
        allow delete: if false;
      }
    }

    // শেষ রক্তদানের তারিখ সংশোধনের অনুরোধ: নিজের নামে পাঠানো আর নিজেরটা দেখা যায়;
    // অনুমোদন শুধু সার্ভারের মাধ্যমে অ্যাডমিন দেন
    match /correctionRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && (request.resource.data.requestedMillis == null || request.resource.data.requestedMillis is int);
      allow read: if signedIn() && resource.data.uid == me();
      allow update, delete: if false;
    }

    // সার্ভারের হিসাব (দৈনিক সীমা ইত্যাদি): অ্যাপ থেকে পড়া বা লেখা যাবে না
    match /serverState/{uid} {
      allow read, write: if false;
    }

    // রিপোর্ট: যে কেউ পাঠাতে পারবে, কেউ পড়তে পারবে না (শুধু কনসোল থেকে দেখা যাবে)
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == me();
      allow read, update, delete: if false;
    }
  }
}
